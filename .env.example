# Copy this file to .env and adjust the values for your environment.
#
# docker-compose.yml reads the POSTGRES_* variables below to initialise the
# database container; the application and Alembic read DATABASE_URL. Keep
# them in step: DATABASE_URL embeds the same user, password and database
# name given to POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB.
#
# Changing POSTGRES_* here does *not* change an already-initialised database:
# those variables are only used by the PostgreSQL image the first time its
# data volume is created. To apply a new password to an existing volume,
# change it inside PostgreSQL itself (or remove the `grademate_pgdata`
# volume and let it re-initialise, which discards its data).

# Credentials docker-compose.yml gives the PostgreSQL container on first
# initialisation. Trivial values are fine for local development, since the
# port is bound to loopback only (see docker-compose.yml).
POSTGRES_USER=grademate
POSTGRES_PASSWORD=grademate
POSTGRES_DB=grademate

# PostgreSQL connection string used by the application and by Alembic.
DATABASE_URL=postgresql+psycopg://grademate:grademate@localhost:5432/grademate

# Emit SQL statements to stdout (useful while developing).
SQL_ECHO=false

# Root of the volume where the exam PDFs are stored.
# Use /data/storage when running the backend inside the container.
STORAGE_ROOT=./storage
