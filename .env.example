# Copy this file to .env and adjust the values for your environment.

# PostgreSQL connection string used by the application and by Alembic.
DATABASE_URL=postgresql+psycopg://grademate:grademate@localhost:5432/grademate

# Emit SQL statements to stdout (useful while developing).
SQL_ECHO=false

# Root of the volume where the exam PDFs are stored.
# Use /data/storage when running the backend inside the container.
STORAGE_ROOT=./storage
